generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // 根据你的数据库调整
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(100) // 存储bcrypt加密后的密码，不存明文
  email     String   @unique @db.VarChar(100)
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 多对多：用户 <-> 角色
  roles Role[]
}

// 角色表：如 admin / operator / viewer
model Role {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(50) // 角色标识 admin
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  permissions Permission[]
}

// 权限表：粒度最小权限，例如 user:create, user:delete, order:list
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(100) // 权限标识 user:create
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles Role[]
}
